# Copy to accounts.yaml (which should be git-ignored) and fill in real keys.
#
# Keys are expected to be unrestricted master application keys. Each account
# in the pool must contain exactly one bucket. `capacity_in_mb` is an optional
# non-negative soft budget; omit it for an account with no local limit.
#
# Get keys from: https://www.backblaze.com/b2/account.html
# Use the account ID and master application key for each account.

max_files_per_account: 1700    # Ignored (legacy field)

accounts:
  - account_id: "0011aabb22ccdd33"
    account_key: "K001..."
    capacity_in_mb: 10240

  - account_id: "0044eeff55aa66bb"
    account_key: "K004..."
    # capacity_in_mb omitted = unlimited